    {
      "name": "7. Test Scenarios",
      "item": [
        {
          "name": "Full Test Flow",
          "item": [
            {
              "name": "1. Check Health",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{hub_endpoint}}/health",
                  "host": ["{{hub_endpoint}}"],
                  "path": ["health"]
                },
                "description": "Step 1: Verify hub is healthy"
              }
            },
            {
              "name": "2. Create RA",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"marketMakerId\": \"RA_TEST\",\n    \"name\": \"Risk Analytics Test\",\n    \"compId\": \"RA_TEST\",\n    \"type\": \"RISK_ANALYTICS\",\n    \"connectionMode\": \"INITIATOR\",\n    \"port\": 9876,\n    \"subscribedSymbols\": [\"TEST*\"],\n    \"active\": true\n}"
                },
                "url": {
                  "raw": "{{hub_endpoint}}/marketmakers",
                  "host": ["{{hub_endpoint}}"],
                  "path": ["marketmakers"]
                },
                "description": "Step 2: Create a test market maker"
              }
            },
            {
              "name": "3. Generate Test Data",
              "request": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{hub_endpoint}}/marketdata/test/TEST001",
                  "host": ["{{hub_endpoint}}"],
                  "path": ["marketdata", "test", "TEST001"]
                },
                "description": "Step 3: Generate test data for TEST001"
              }
            },
            {
              "name": "4. Verify Data",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{hub_endpoint}}/marketdata/TEST001",
                  "host": ["{{hub_endpoint}}"],
                  "path": ["marketdata", "TEST001"]
                },
                "description": "Step 4: Verify data was cached"
              }
            },
            {
              "name": "5. Check Status",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{hub_endpoint}}/status",
                  "host": ["{{hub_endpoint}}"],
                  "path": ["status"]
                },
                "description": "Step 5: Check overall status"
              }
            }
          ],
          "description": "Complete test flow from setup to verification"
        },
        {
          "name": "Load Test",
          "item": [
            {
              "name": "Generate 10 Symbols",
              "request": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{hub_endpoint}}/marketdata/test/LOAD_{{$randomInt}}",
                  "host": ["{{hub_endpoint}}"],
                  "path": ["marketdata", "test", "LOAD_{{$randomInt}}"]
                },
                "description": "Run this multiple times to generate load (use Collection Runner)"
              }
            }
          ],
          "description": "Load testing scenarios"
        }
      ],
      "description": "Pre-configured test scenarios"
    }
