{
  "info": {
    "name": "Market Data Hub V1",
    "description": "Complete API collection for testing Market Data Hub V1 - a lightweight FIX engine for distributing market data from Refinitiv to market makers (RA and CMF).\n\n## Prerequisites\n- Application running on localhost:8080\n- H2 database (embedded)\n- FIX acceptor on port 9876\n\n## How to Use\n1. Import this collection and the environment file\n2. Select 'MarketHub Environment'\n3. Run requests in order for best results",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health & Monitoring",
      "item": [
        {
          "name": "Get Health Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Hub is UP\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"UP\");",
                  "});",
                  "",
                  "pm.test(\"FIX is running\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.components.fix).to.eql(\"UP\");",
                  "});",
                  "",
                  "pm.test(\"Hazelcast is running\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.components.hazelcast).to.eql(\"UP\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{hub_endpoint}}/health",
              "host": ["{{hub_endpoint}}"],
              "path": ["health"]
            },
            "description": "Returns overall health status of the Market Data Hub including component status and statistics"
          }
        },
        {
          "name": "Get Detailed Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{hub_endpoint}}/status",
              "host": ["{{hub_endpoint}}"],
              "path": ["status"]
            },
            "description": "Returns detailed status information including FIX sessions, market maker stats, and Hazelcast info"
          }
        },
        {
          "name": "Get Actuator Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{actuator_endpoint}}/health",
              "host": ["{{actuator_endpoint}}"],
              "path": ["health"]
            },
            "description": "Spring Boot Actuator health endpoint with detailed component health"
          }
        },
        {
          "name": "Get Prometheus Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{actuator_endpoint}}/prometheus",
              "host": ["{{actuator_endpoint}}"],
              "path": ["prometheus"]
            },
            "description": "Prometheus-formatted metrics for monitoring and alerting"
          }
        }
      ],
      "description": "Health check and monitoring endpoints"
    },
    {
      "name": "2. Market Maker Management",
      "item": [
        {
          "name": "Create RA Market Maker",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Market maker created\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.marketMakerId).to.eql(\"RA\");",
                  "    pm.expect(jsonData.name).to.eql(\"Risk Analytics\");",
                  "    ",
                  "    // Save ID for later use",
                  "    if(jsonData.id) {",
                  "        pm.environment.set(\"ra_market_maker_id\", jsonData.id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"marketMakerId\": \"RA\",\n    \"name\": \"Risk Analytics\",\n    \"compId\": \"RA\",\n    \"type\": \"RISK_ANALYTICS\",\n    \"connectionMode\": \"INITIATOR\",\n    \"host\": \"localhost\",\n    \"port\": {{fix_port}},\n    \"heartbeatInterval\": 30,\n    \"subscribedSymbols\": [\"AAPL\", \"GOOGL\", \"SPX*\", \"MSFT\", \"AMZN\"],\n    \"active\": true,\n    \"priority\": 10,\n    \"maxMessagesPerSecond\": 100,\n    \"requiresAuthentication\": false,\n    \"productMappingJson\": \"{\\\"AAPL\\\":\\\"AAPL.O\\\",\\\"GOOGL\\\":\\\"GOOG.O\\\"}\",\n    \"transformationRulesJson\": \"{\\\"priceMultiplier\\\":1,\\\"volumeDivisor\\\":1}\"\n}"
            },
            "url": {
              "raw": "{{hub_endpoint}}/marketmakers",
              "host": ["{{hub_endpoint}}"],
              "path": ["marketmakers"]
            },
            "description": "Creates the Risk Analytics (RA) market maker configuration"
          }
        },
        {
          "name": "Create CMF Market Maker",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Market maker created\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.marketMakerId).to.eql(\"CMF\");",
                  "    pm.expect(jsonData.name).to.eql(\"Capital Markets Framework\");",
                  "    ",
                  "    // Save ID for later use",
                  "    if(jsonData.id) {",
                  "        pm.environment.set(\"cmf_market_maker_id\", jsonData.id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"marketMakerId\": \"CMF\",\n    \"name\": \"Capital Markets Framework\",\n    \"compId\": \"CMF\",\n    \"type\": \"CAPITAL_MARKETS\",\n    \"connectionMode\": \"INITIATOR\",\n    \"host\": \"localhost\",\n    \"port\": {{fix_port}},\n    \"heartbeatInterval\": 30,\n    \"subscribedSymbols\": [\"*\"],\n    \"active\": true,\n    \"priority\": 5,\n    \"maxMessagesPerSecond\": 200,\n    \"requiresAuthentication\": false\n}"
            },
            "url": {
              "raw": "{{hub_endpoint}}/marketmakers",
              "host": ["{{hub_endpoint}}"],
              "path": ["marketmakers"]
            },
            "description": "Creates the Capital Markets Framework (CMF) market maker configuration"
          }
        },
        {
          "name": "List All Market Makers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Returns array of market makers\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{hub_endpoint}}/marketmakers",
              "host": ["{{hub_endpoint}}"],
              "path": ["marketmakers"]
            },
            "description": "Returns all configured market makers"
          }
        },
        {
          "name": "Get Market Maker by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{hub_endpoint}}/marketmakers/{{ra_market_maker_id}}",
              "host": ["{{hub_endpoint}}"],
              "path": ["marketmakers", "{{ra_market_maker_id}}"]
            },
            "description": "Returns a specific market maker configuration by ID"
          }
        },
        {
          "name": "Update Market Maker",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"marketMakerId\": \"RA\",\n    \"name\": \"Risk Analytics - Updated\",\n    \"compId\": \"RA\",\n    \"type\": \"RISK_ANALYTICS\",\n    \"connectionMode\": \"INITIATOR\",\n    \"host\": \"localhost\",\n    \"port\": {{fix_port}},\n    \"heartbeatInterval\": 60,\n    \"subscribedSymbols\": [\"AAPL\", \"GOOGL\", \"SPX*\", \"MSFT\", \"TSLA\"],\n    \"active\": true,\n    \"priority\": 15,\n    \"maxMessagesPerSecond\": 150,\n    \"requiresAuthentication\": false\n}"
            },
            "url": {
              "raw": "{{hub_endpoint}}/marketmakers/{{ra_market_maker_id}}",
              "host": ["{{hub_endpoint}}"],
              "path": ["marketmakers", "{{ra_market_maker_id}}"]
            },
            "description": "Updates an existing market maker configuration"
          }
        },
        {
          "name": "Activate Market Maker",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{hub_endpoint}}/marketmakers/{{ra_market_maker_id}}/activate",
              "host": ["{{hub_endpoint}}"],
              "path": ["marketmakers", "{{ra_market_maker_id}}", "activate"]
            },
            "description": "Activates a market maker to start receiving data"
          }
        },
        {
          "name": "Deactivate Market Maker",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{hub_endpoint}}/marketmakers/{{ra_market_maker_id}}/deactivate",
              "host": ["{{hub_endpoint}}"],
              "path": ["marketmakers", "{{ra_market_maker_id}}", "deactivate"]
            },
            "description": "Deactivates a market maker to stop receiving data"
          }
        },
        {
          "name": "Delete Market Maker",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{hub_endpoint}}/marketmakers/{{ra_market_maker_id}}",
              "host": ["{{hub_endpoint}}"],
              "path": ["marketmakers", "{{ra_market_maker_id}}"]
            },
            "description": "Deletes a market maker configuration"
          }
        }
      ],
      "description": "CRUD operations for market maker configurations"
    },
    {
      "name": "3. Market Data",
      "item": [
        {
          "name": "Generate Test Data - AAPL",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Market data generated\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.symbol).to.eql(\"AAPL\");",
                  "    pm.expect(jsonData.bidPrice).to.exist;",
                  "    pm.expect(jsonData.askPrice).to.exist;",
                  "    pm.expect(jsonData.lastPrice).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{hub_endpoint}}/marketdata/test/AAPL",
              "host": ["{{hub_endpoint}}"],
              "path": ["marketdata", "test", "AAPL"]
            },
            "description": "Generates test market data for AAPL and distributes it through the hub"
          }
        },
        {
          "name": "Generate Test Data - GOOGL",
          "request": {
            "method": "POST",
            "header": [],
