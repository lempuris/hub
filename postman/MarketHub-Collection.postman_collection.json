        },
        {
          "name": "Generate Test Data - SPX",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{hub_endpoint}}/marketdata/test/SPX",
              "host": ["{{hub_endpoint}}"],
              "path": ["marketdata", "test", "SPX"]
            },
            "description": "Generates test market data for S&P 500 Index"
          }
        },
        {
          "name": "Generate Test Data - Custom Symbol",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{hub_endpoint}}/marketdata/test/{{test_symbol}}",
              "host": ["{{hub_endpoint}}"],
              "path": ["marketdata", "test", "{{test_symbol}}"]
            },
            "description": "Generates test market data for a custom symbol (set in environment)"
          }
        },
        {
          "name": "Get Market Data - AAPL",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Returns AAPL market data\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.symbol).to.eql(\"AAPL\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{hub_endpoint}}/marketdata/AAPL",
              "host": ["{{hub_endpoint}}"],
              "path": ["marketdata", "AAPL"]
            },
            "description": "Gets the latest cached market data for AAPL"
          }
        },
        {
          "name": "Get All Market Data",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Returns market data map\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('object');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{hub_endpoint}}/marketdata",
              "host": ["{{hub_endpoint}}"],
              "path": ["marketdata"]
            },
            "description": "Gets all cached market data"
          }
        }
      ],
      "description": "Market data generation and retrieval endpoints"
    },
    {
      "name": "4. FIX Management",
      "item": [
        {
          "name": "Get FIX Connection Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{hub_endpoint}}/fix/info",
              "host": ["{{hub_endpoint}}"],
              "path": ["fix", "info"]
            },
            "description": "Gets FIX acceptor status and connection instructions"
          }
        },
        {
          "name": "Send Test Message to RA",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{hub_endpoint}}/fix/test/RA",
              "host": ["{{hub_endpoint}}"],
              "path": ["fix", "test", "RA"]
            },
            "description": "Sends a FIX test request message to the RA session"
          }
        },
        {
          "name": "Send Test Message to CMF",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{hub_endpoint}}/fix/test/CMF",
              "host": ["{{hub_endpoint}}"],
              "path": ["fix", "test", "CMF"]
            },
            "description": "Sends a FIX test request message to the CMF session"
          }
        },
        {
          "name": "Disconnect FIX Session",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{hub_endpoint}}/fix/disconnect/RA",
              "host": ["{{hub_endpoint}}"],
              "path": ["fix", "disconnect", "RA"]
            },
            "description": "Disconnects a specific FIX session"
          }
        },
        {
          "name": "Restart FIX Acceptor",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{hub_endpoint}}/fix/restart",
              "host": ["{{hub_endpoint}}"],
              "path": ["fix", "restart"]
            },
            "description": "Restarts the FIX acceptor - useful for applying configuration changes"
          }
        }
      ],
      "description": "FIX protocol management endpoints"
    },
